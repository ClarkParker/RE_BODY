// ===== 20_analysis.cmajor =====
// RE-BODY analysis helpers: pure functions and plain structs, no processors and no state of
// their own. The shared analysis stage (transient/sustain split, LR4 3-band split, pitch,
// concept section 13) arrives in P2/P4b and is built from these; P1 only needs the coefficient
// helpers and one novelty detector per line (T9).
//
// Every divisor below is provably non-zero (max(..., epsilon)); every cutoff is clamped to
// 0.45 * sr (P03 2b).

namespace rebody::analysis
{
    // Smallest time constant / sample rate used inside divisors.
    const float epsilon = 0.00001f;

    // Replace NaN/Inf by 0 (BODY:587 input guard).
    float finiteOrZero (float v)
    {
        if (isnan (v) || isinf (v))
            return 0.0f;

        return v;
    }

    // Clamp a cutoff or tone frequency to 1 Hz .. 0.45 * sr.
    float limitHz (float hz, float sr)
    {
        return clamp (hz, 1.0f, 0.45f * max (sr, 1000.0f));
    }

    // One-pole low-pass coefficient for y += a * (x - y) from a cutoff in Hz (BODY:520).
    float onePoleCoefficient (float hz, float sr)
    {
        return 1.0f - float (exp (-float (twoPi) * limitHz (hz, sr) / max (sr, 1000.0f)));
    }

    // Per-sample slew coefficient for y += a * (target - y) with time constant `seconds`
    // (BODY:513 onsetRise/onsetFall, 510 fastSlew).
    float slewCoefficient (float seconds, float sr)
    {
        return 1.0f - float (exp (-1.0f / (max (seconds, epsilon) * max (sr, 1000.0f))));
    }

    // Slew coefficient for a control that is stepped once per `ticks` samples (BODY:509).
    float tickSlewCoefficient (float seconds, float sr, int ticks)
    {
        return 1.0f - float (exp (-float (max (ticks, 1)) / (max (seconds, epsilon) * max (sr, 1000.0f))));
    }

    // Per-sample release multiplier for y = max(x, y * r) peak followers (BODY:512 peakRelease).
    float releaseMultiplier (float seconds, float sr)
    {
        return float (exp (-1.0f / (max (seconds, epsilon) * max (sr, 1000.0f))));
    }

    // Pole radius of the 1-pole DC blocker y = x - x[-1] + r * y[-1] (BODY:511).
    float dcBlockRadius (float hz, float sr)
    {
        return float (exp (-float (twoPi) * limitHz (hz, sr) / max (sr, 1000.0f)));
    }

    float dbToGain (float db)
    {
        return float (pow (10.0f, 0.05f * db));
    }

    // Sensitivity 0..100 to linear gain: 0 -> -24 dB, 50 -> 0 dB (unity), 100 -> +24 dB (concept 13).
    float sensitivityGain (float percent)
    {
        return dbToGain ((clamp (percent, 0.0f, 100.0f) - 50.0f) * 0.48f);
    }

    // One step of an attack/release envelope: rise towards a higher target, fall towards a lower one.
    float envelopeStep (float envelope, float target, float riseCoefficient, float fallCoefficient)
    {
        float coefficient = target > envelope ? riseCoefficient : fallCoefficient;
        return envelope + coefficient * (target - envelope);
    }

    // Peak follower with exponential release (BODY:591 peak).
    float peakStep (float peak, float level, float release)
    {
        return max (level, peak * release);
    }

    // BODY's novelty measure (BODY:591): how far the fast peak sits above the slow peak, gated
    // by an absolute level so silence never reports an onset. Result 0..1.
    float novelty (float peak, float slowPeak)
    {
        float relative = clamp ((peak - 1.2f * slowPeak - 0.0015f) / (max (peak, 0.0f) + 0.012f), 0.0f, 1.0f);
        float gate = float (sqrt (clamp ((peak - 0.0015f) / 0.08f, 0.0f, 1.0f)));
        return relative * gate;
    }

    // Onset detector state: one per line, run on that line's listened signal (T9).
    struct OnsetState
    {
        float peak;
        float slowPeak;
        float novelty;
        float onset;
    }

    // Detector time constants (BODY:512-513): peak release 60 ms, slow follower 18 ms,
    // onset rise 0.35 ms, onset fall 50 ms.
    struct OnsetCoefficients
    {
        float peakRelease;
        float slowSlew;
        float rise;
        float fall;
    }

    OnsetCoefficients onsetCoefficients (float sr)
    {
        OnsetCoefficients c;
        c.peakRelease = releaseMultiplier (0.06f, sr);
        c.slowSlew = slewCoefficient (0.018f, sr);
        c.rise = slewCoefficient (0.00035f, sr);
        c.fall = slewCoefficient (0.05f, sr);
        return c;
    }

    // One sample of the detector (BODY:591-594). `level` is the rectified listened signal (>= 0).
    void onsetStep (OnsetState& s, OnsetCoefficients c, float level)
    {
        s.peak = peakStep (s.peak, level, c.peakRelease);
        s.slowPeak += c.slowSlew * (s.peak - s.slowPeak);
        s.novelty = novelty (s.peak, s.slowPeak);
        s.onset = envelopeStep (s.onset, s.novelty, c.rise, c.fall);

        if (s.onset < 0.000001f && s.novelty == 0.0f)
            s.onset = 0.0f;
    }

    void onsetReset (OnsetState& s)
    {
        s.peak = 0.0f;
        s.slowPeak = 0.0f;
        s.novelty = 0.0f;
        s.onset = 0.0f;
    }
}

// ===== 30_strikers.cmajor =====
// RE-BODY strikers (concept section 14): one shared module used by all three lines. Hammer,
// Pluck and Breath are onset-triggered excitations that replace (or, with Blend, join) the
// audio-through contact. P1 declares the state and the documented signatures so the line
// struct has its final size; the bodies are filled in P4b (ported from PHYSIFY DSP:913-1004,
// :2060-2131). Until then every striker returns silence and never triggers.
//
// Contract for the real implementation:
//  - every striker output is DC-blocked (unipolar force pulses inject DC) and energy-normalised
//    to the listened envelope, so Blend 50 is a real half/half;
//  - triggering has hysteresis and a 30 ms refractory time, so a Low-listening Hammer line does
//    not fire on hi-hats;
//  - velocity comes from the onset energy (log map, Touch = curve), position from the line's
//    Position parameter.

namespace rebody::strikers
{
    // Values of the Excite parameter (spec.json param12/35/58: Through|Hammer|Pluck|Breath).
    const int modeThrough = 0;
    const int modeHammer = 1;
    const int modePluck = 2;
    const int modeBreath = 3;

    struct StrikerState
    {
        int mode;               // excite mode captured when the strike was triggered
        int age;                // samples since the trigger; negative = idle
        int refractory;         // samples left before another trigger is accepted (30 ms)
        float velocity;         // 0..1, from the onset energy at the trigger
        float envelope;         // strike envelope used for energy normalisation
        float<2> force;         // last striker sample before DC blocking
        float<2> dcPrevious;    // DC blocker input memory
        float<2> dcState;       // DC blocker state
        int noiseState;         // xorshift state for Breath (seeded per line in initLine)
    }

    void reset (StrikerState& s)
    {
        s.mode = modeThrough;
        s.age = -1;
        s.refractory = 0;
        s.velocity = 0.0f;
        s.envelope = 0.0f;
        s.force = float<2> (0.0f);
        s.dcPrevious = float<2> (0.0f);
        s.dcState = float<2> (0.0f);
    }

    // Decide whether this sample starts a strike. `onset` is the line's detector output 0..1,
    // `touch` is Touch 0..1 (onset threshold), `refractorySamples` is 30 ms in samples.
    // P1 stub: never triggers.
    bool trigger (StrikerState& s, float onset, float touch, int refractorySamples)
    {
        return false;
    }

    // One sample of the active strike, stereo. `excite` is a mode constant above, `position`
    // and `hardness` are Position and Reed 0..1, `pitchHz` is the line's root for Pluck/Breath
    // timing, `sr` the sample rate. P1 stub: silence.
    float<2> step (StrikerState& s, int excite, float position, float hardness, float pitchHz, float sr)
    {
        return float<2> (0.0f);
    }

    // Scale a strike so its energy follows the listened envelope. P1 stub: pass-through.
    float<2> normalise (float<2> strike, float listenedEnvelope, float strikeEnvelope)
    {
        return strike;
    }

    // Equal-power Blend law (Blend 0..100 %): 0 = striker alone, 100 = Through alone (concept 14).
    float strikeGain (float blendPercent)
    {
        return float (cos (0.5f * float (pi) * clamp (blendPercent, 0.0f, 100.0f) * 0.01f));
    }

    float throughGain (float blendPercent)
    {
        return float (sin (0.5f * float (pi) * clamp (blendPercent, 0.0f, 100.0f) * 0.01f));
    }
}

// ===== 40_modal.cmajor =====
// RE-BODY modal bodies (concept sections 2, 3, 4, 16). Per line, the body is
//  (a) one shared log pole GRID (96 poles, 60 Hz .. 8 kHz) that carries the dense fixed-Hz
//      response (soundboard, box hump, bridge hill, bell and brass radiation); each body owns a
//      signed L/R gain vector over the grid, Size shifts the grid, Material/Decay set the T60 law;
//  (b) per-body SLOTS: up to 8 fixed-Hz feature modes and 10 Tune-following modes per body,
//      for 11 bodies, with BODY-style tail holding (a body at weight 0 keeps its last voicing).
// Every mode is a complex one-pole (phasor, coupled form) as BODY:604-613: click-free under
// modulation by construction. Coefficients are stepped from a target at the 32-sample control
// tick (BODY:579), so the per-sample cost is the coupled-form update only.
//
// P1 provides the final-size state and the pure step helpers; the table-driven control logic
// (blended T60, normalisation, Size shift, staggered recompute) is P2.

namespace rebody::modal
{
    // Slot mode layout inside the flat slot arrays (index = slot mode number):
    //   feature mode k of body b   -> b * 8 + k                      (0 .. 87)
    //   following mode k of body b -> 88 + b * 10 + k                (88 .. 197)
    int featureIndex (int body, int k)
    {
        return clamp (body, 0, numBodies - 1) * featureStride + clamp (k, 0, featureStride - 1);
    }

    int followIndex (int body, int k)
    {
        return numBodies * featureStride + clamp (body, 0, numBodies - 1) * followStride + clamp (k, 0, followStride - 1);
    }

    // The 96 shared poles of one line. re/im hold the L/R phasor state; the pole (cos/sin form)
    // and the per-channel drive ramp from the current value to the target over one control tick.
    struct GridState
    {
        float<2>[96] re;
        float<2>[96] im;
        float[96] poleRe;
        float[96] poleIm;
        float[96] targetPoleRe;
        float[96] targetPoleIm;
        float[96] stepPoleRe;
        float[96] stepPoleIm;
        float<2>[96] drive;             // signed L/R input gain of each pole (blended body gains)
        float<2>[96] targetDrive;
        float<2>[96] stepDrive;
    }

    // The 198 slot modes of one line (11 bodies x (8 feature + 10 following)). Same layout as the
    // grid; weight-0 bodies keep their coefficients and ring out (tail holding, BODY:226-266).
    struct SlotState
    {
        float<2>[198] re;
        float<2>[198] im;
        float[198] poleRe;
        float[198] poleIm;
        float[198] targetPoleRe;
        float[198] targetPoleIm;
        float[198] stepPoleRe;
        float[198] stepPoleIm;
        float<2>[198] drive;
        float<2>[198] targetDrive;
        float<2>[198] stepDrive;
        float[198] energy;              // control-rate energy estimate per mode (gating, lineModes telemetry)
    }

    // T60 in seconds of a mode at `hz` under the damping law alpha(w) = alphaG + alphaR * w
    // (concept 4): T60 = ln(1000) / (alphaG + alphaR * 2 pi f). Never returns less than 1 ms.
    float t60FromDamping (float hz, float alphaG, float alphaR)
    {
        float alpha = max (alphaG, 0.0f) + max (alphaR, 0.0f) * float (twoPi) * max (hz, 0.0f);
        return max (0.001f, 6.907755f / max (alpha, 0.000001f));
    }

    // Pole radius for a given T60: the amplitude falls by 60 dB in t60 seconds (BODY: exp(-ln(1000)/(sr*t))).
    float poleRadius (float t60Seconds, float sr)
    {
        return float (exp (-6.907755f / (max (t60Seconds, 0.001f) * max (sr, 1000.0f))));
    }

    // Cos/sin form of a pole at `hz` with the given radius. Frequencies are limited to 0.45 * sr
    // (Nyquist culling, concept 7); the radius stays below 1 by construction.
    float poleReal (float hz, float radius, float sr)
    {
        float angle = float (twoPi) * clamp (hz, 0.0f, 0.45f * max (sr, 1000.0f)) / max (sr, 1000.0f);
        return min (radius, 0.999999f) * float (cos (angle));
    }

    float poleImag (float hz, float radius, float sr)
    {
        float angle = float (twoPi) * clamp (hz, 0.0f, 0.45f * max (sr, 1000.0f)) / max (sr, 1000.0f);
        return min (radius, 0.999999f) * float (sin (angle));
    }

    // Input scaling that keeps a mode's response level independent of its radius (BODY ukeBodyDrive).
    float driveNormalisation (float radius)
    {
        return 2.0f * (1.0f - min (radius, 0.999999f));
    }

    // Per-sample step that moves `current` onto `target` within `ticks` samples (control tick).
    float rampStep (float current, float target, int ticks)
    {
        return (target - current) / float (max (ticks, 1));
    }

    // One coupled-form update of a stereo mode (BODY:604-613):
    //   re' = poleRe * re - poleIm * im + drive * excitation
    //   im' = poleIm * re + poleRe * im
    // The modal output is re. |pole| < 1 keeps it stable.
    void stepMode (float poleRe, float poleIm, float<2> drive, float<2> excitation, float<2>& re, float<2>& im)
    {
        float<2> oldRe = re;
        float<2> oldIm = im;
        re = poleRe * oldRe - poleIm * oldIm + drive * excitation;
        im = poleIm * oldRe + poleRe * oldIm;
    }

    // Zero a mode whose state has decayed below `floorLevel` (flush at control rate, not per
    // sample; BODY's 1e-12 is -240 dB, concept 7 gates at -120 dB relative).
    void flushMode (float<2>& re, float<2>& im, float floorLevel)
    {
        for (int ch = 0; ch < 2; ch += 1)
        {
            if (abs (re.at (ch)) + abs (im.at (ch)) < floorLevel)
            {
                re.at (ch) = 0.0f;
                im.at (ch) = 0.0f;
            }
        }
    }

    void resetGrid (GridState& g)
    {
        for (int i = 0; i < gridPoles; i += 1)
        {
            g.re.at (i) = float<2> (0.0f);
            g.im.at (i) = float<2> (0.0f);
            g.drive.at (i) = float<2> (0.0f);
            g.targetDrive.at (i) = float<2> (0.0f);
            g.stepDrive.at (i) = float<2> (0.0f);
        }
    }

    void resetSlots (SlotState& s)
    {
        for (int i = 0; i < slotModes; i += 1)
        {
            s.re.at (i) = float<2> (0.0f);
            s.im.at (i) = float<2> (0.0f);
            s.drive.at (i) = float<2> (0.0f);
            s.targetDrive.at (i) = float<2> (0.0f);
            s.stepDrive.at (i) = float<2> (0.0f);
        }
    }
}

// ===== 50_line.cmajor =====
// RE-BODY line state (concept sections 2, 12, 16). A LINE is one complete BODY-style chain:
// listened signal, its own onset detector (T9), strikers, per-body feeds with sqrt-weight
// crossfade, the four line engines, grid and slots, the loudness stage and tail holding. Three
// identical lines run in parallel as `Line[3]` inside the single processor (P1 checks that the
// compiler accepts that struct array, Cmajor #94; fallback = three members, see 90_main).
//
// Memory per line (floats): bore 8192 + sax 8192 + shared string 8192 + pick comb 4096 + piano
// pair 32768 = 61 440 in delay lines, plus about 6 k of modal and control state. Three lines are
// about 184 k floats, above the 131 072-float stall guideline of core-dsp, hence the T4 measurement
// recorded in docs/dev/01_TABLE_EMISSION.md.
//
// Struct fields are declarations only (no initialisers); initLine() sets the non-zero defaults.
// P1 fills the state with stubs: the engines only advance their write heads, the line output is
// silence. The field names follow BODY's state (BODY:40-118) so P2 can port engine by engine.

namespace rebody::line
{
    // Clarinet: closed cylinder, negative reflection each half period = odd modes (BODY:54-61).
    struct BoreEngine
    {
        float<2>[4096] buffer;
        int write;
        float delay, delayTarget, delayStep;       // loop delay in samples (pitch)
        float gain, gainTarget, gainStep;          // loop gain (decay)
        float drive, driveTarget, driveStep;       // reed drive
        float<2> lowpass;                          // in-loop low-pass state (1.75 kHz default, T6)
        float<2> radiation;                        // radiation filter outside the loop (1.4 kHz, T6)
        float<2> reedLowpass, reedEnvelope, reedPeak;
    }

    // Sax: positive full-period bore with continuous asymmetric reed (BODY:86-96).
    struct SaxEngine
    {
        float<2>[4096] buffer;
        int write;
        float delay, delayTarget, delayStep;
        float gain, gainTarget, gainStep;
        float drive, driveTarget, driveStep;
        float<2> lowpass;                          // in-loop low-pass state (6.6 kHz default, T6)
        float<2> radiation;                        // radiation filter outside the loop (1.0 kHz, T6)
        float<2> reedPrevious, reedDC;
        float<2> breathEnvelope, breathLow, breathHigh, formantLow, formantHigh;
        int[2] noiseState;
    }

    // One shared string for Guitar, Ukulele and Fiddle: same physical object retuned by the shared
    // register (BODY:74-83), with the pick/position comb (BODY:376, :689-690).
    struct StringEngine
    {
        float<2>[4096] buffer;
        int write;
        float delay, delayTarget, delayStep;
        float gain, gainTarget, gainStep;
        float drive, driveTarget, driveStep;
        float<2> lowpass, contact, previous;
        float<2> dispersionState;
        float<2>[2048] pickBuffer;
        int pickWrite;
        float pickDelay, pickDelayTarget, pickDelayStep;
    }

    // Piano: two detuned, dispersive strings, positive reflection supports all harmonics (BODY:63-71).
    struct PianoEngine
    {
        float<2>[8192] string0;
        float<2>[8192] string1;
        int write;
        float[2] delay, delayTarget, delayStep;
        float[2] gain, gainTarget, gainStep;
        float[2] drive, driveTarget, driveStep;
        float<2>[2] lowpass, dispersionState;
        float<2> hammerLowpass, hammerPrevious;
    }

    struct Line
    {
        // Modal body: shared grid plus per-body slots (T1).
        rebody::modal::GridState grid;
        rebody::modal::SlotState slots;

        // Line engines.
        BoreEngine clarinet;
        SaxEngine sax;
        StringEngine stringEngine;
        PianoEngine piano;

        // Onset detector (T9) and strikers (N11).
        rebody::analysis::OnsetState onset;
        rebody::strikers::StrikerState striker;

        // Smoothed block parameters in physical units, in slot order (rebody::params::slot*).
        float[23] control;
        bool enabled;

        // Morph: per-anchor weights, sqrt-weight feeds (BODY:147-172), anchor order 0..10.
        float[11] weight;
        float[11] feed;
        int dominant;                              // anchor with the largest weight
        float pitchedWeight;                       // summed weight of the pitched bodies (all but Bass Drum, Snare)

        // Register, decay and contact state shared by the active bodies; withdrawn bodies keep
        // their last values while their tails drain (BODY:226-266).
        float[11] logRoot, logSeconds, sustain, sizeNow;
        float rootHz, t60, sustainEff;

        // Follow, Hold and the listened signal.
        float followHz, holdState, listenEnergy;
        float<2> listened;

        // Loudness stage: pitched balance AGC with the line's own pitchedWeight (BODY:844-855).
        float balanceInputPower, balanceOutputPower, balanceGain, balanceTarget;

        // Line output: after the loudness stage and before Level (Chain source), then after Level and Pan.
        float<2> bodyOut;
        float<2> wet;

        // Telemetry accumulators, peak-held between 30 Hz frames and reset by takeState().
        float wetPeakL, wetPeakR, onsetHold;
        float[16] modeEnergy;
    }

    // State that belongs to the sum of the lines (not to one line): the global Low Cut, the final DC
    // block of the wet sum and the shared protector + knee referenced to the input peak (BODY:857-889).
    struct Protector
    {
        float protect;
        int protectHold;
        float protectGain;
        float inputPeakReference;
        int referenceQuietSamples;
        float<2> lowCutIn1, lowCutIn2, lowCutOut1, lowCutOut2;   // Low Cut, 12 dB/oct biquad
        float<2> dcPrevious, dcState;                              // DC block of the wet sum
    }

    void initProtector (Protector& p)
    {
        p.protect = 0.0f;
        p.protectHold = 0;
        p.protectGain = 1.0f;
        p.inputPeakReference = 0.0f;
        p.referenceQuietSamples = 0;
    }

    // Non-zero defaults; everything else starts at zero. `seed` differs per line so Breath noise
    // is decorrelated between lines.
    void initLine (Line& l, int seed)
    {
        rebody::modal::resetGrid (l.grid);
        rebody::modal::resetSlots (l.slots);
        rebody::analysis::onsetReset (l.onset);
        rebody::strikers::reset (l.striker);
        l.striker.noiseState = 17431 + 7919 * seed;
        l.sax.noiseState.at (0) = 281391 + 7919 * seed;
        l.sax.noiseState.at (1) = 891137 + 7919 * seed;
        l.balanceGain = 1.0f;
        l.balanceTarget = 1.0f;
        l.weight.at (0) = 1.0f;
        l.feed.at (0) = 1.0f;
        l.dominant = 0;
    }

    // Anchor weights from the Morph position 0..10: linear between the two neighbouring anchors,
    // sqrt-weight feeds as BODY (BODY:126-172). P1 placeholder: the hybrid segment 9 -> 10 is a plain
    // interpolation here; P4 replaces it with the re-coupled Obosaxolele and tail holding.
    void updateMorphWeights (Line& l)
    {
        float morph = clamp (l.control.at (rebody::params::slotMorph), 0.0f, float (rebody::numBodies - 1));
        int left = min (rebody::numBodies - 2, int (floor (morph)));
        float fraction = morph - float (left);

        for (int body = 0; body < rebody::numBodies; body += 1)
        {
            l.weight.at (body) = 0.0f;
            l.feed.at (body) = 0.0f;
        }

        l.weight.at (left) = 1.0f - fraction;
        l.weight.at (left + 1) = fraction;
        l.feed.at (left) = float (sqrt (1.0f - fraction));
        l.feed.at (left + 1) = float (sqrt (fraction));
        l.dominant = fraction < 0.5f ? left : left + 1;

        float pitched = 0.0f;
        for (int body = 2; body < rebody::numBodies; body += 1)
            pitched += l.weight.at (body);
        l.pitchedWeight = pitched;
    }

    // P1 stub of one line sample: advance the engine write heads with the listened signal (so the
    // full-size state is live) and produce no sound. Returns the line's wet contribution (silence).
    float<2> stubProcess (Line& l, float<2> listenedSignal)
    {
        l.listened = listenedSignal;

        l.clarinet.buffer.at (l.clarinet.write) = listenedSignal;
        l.clarinet.write = (l.clarinet.write + 1) % rebody::boreBufferSize;

        l.sax.buffer.at (l.sax.write) = listenedSignal;
        l.sax.write = (l.sax.write + 1) % rebody::saxBufferSize;

        l.stringEngine.buffer.at (l.stringEngine.write) = listenedSignal;
        l.stringEngine.write = (l.stringEngine.write + 1) % rebody::stringBufferSize;
        l.stringEngine.pickBuffer.at (l.stringEngine.pickWrite) = listenedSignal;
        l.stringEngine.pickWrite = (l.stringEngine.pickWrite + 1) % rebody::pickBufferSize;

        l.piano.string0.at (l.piano.write) = listenedSignal;
        l.piano.string1.at (l.piano.write) = listenedSignal;
        l.piano.write = (l.piano.write + 1) % rebody::pianoBufferSize;

        l.bodyOut = float<2> (0.0f);
        l.wet = float<2> (0.0f);
        return l.wet;
    }

    // Peak-hold the telemetry accumulators (cheap, every sample).
    void accumulate (Line& l)
    {
        l.wetPeakL = max (l.wetPeakL, abs (l.wet[0]));
        l.wetPeakR = max (l.wetPeakR, abs (l.wet[1]));
        l.onsetHold = max (l.onsetHold, l.onset.onset);
    }

    // The lineStateA/B/C frame (spec.json outputs): wet, onset, listenEnergy, followHz, hold, rootHz,
    // t60, sustainEff, dominantBody, engine0..engine10 (anchor weights), 4 spare. Reads the
    // peak-hold accumulators and resets them.
    float<24> takeState (Line& l)
    {
        float<24> v = float<24> (0.0f);
        v[0] = max (l.wetPeakL, l.wetPeakR);
        v[1] = l.onsetHold;
        v[2] = l.listenEnergy;
        v[3] = l.followHz;
        v[4] = l.holdState;
        v[5] = l.rootHz;
        v[6] = l.t60;
        v[7] = l.sustainEff;
        v[8] = float (l.dominant);

        for (int body = 0; body < rebody::numBodies; body += 1)
            v.at (9 + body) = l.weight.at (body);

        l.wetPeakL = 0.0f;
        l.wetPeakR = 0.0f;
        l.onsetHold = 0.0f;
        return v;
    }

    // The lineModesA/B/C frame: energy of the first 16 slot modes of the dominant body in fixed
    // recipe index order. P1 reports the (zero) accumulator.
    float<16> modesState (Line& l)
    {
        float<16> v = float<16> (0.0f);

        for (int k = 0; k < 16; k += 1)
            v.at (k) = l.modeEnergy.at (k);

        return v;
    }
}

// ===== 90_main.cmajor =====
// RE-BODY main processor (Amorph FX: audio in, bodies, audio out, no MIDI).
//
// P1 skeleton: all 73 parameters and 10 telemetry endpoints exist with their final ids and
// ranges, the three lines carry their final-size state, and the signal path conditions the input
// as BODY does (NaN guard, DC block, clamp, bypass fade). The wet path is silent for now, so the
// output is dry * (1 - mix); the DSP of the bodies arrives from P2 on.
//
// Signal path per sample (concept 20 section 2):
//   in -> NaN guard, DC block, clamp, bypass fade                         (BODY:587-590)
//      -> per enabled line: onset detector, stubs                          (P2+: engines, grid, slots)
//      -> sum of lines                                                     (P2+: Low Cut, protector, knee)
//      -> Mix, linear as BODY on purpose                                   (BODY:890)
//   meters and telemetry every max(1, int(sr / 30)) samples               (BODY:893)
//
// Cmajor #94 check: the three lines are `Line[3] lines`. If a compiler version rejects a struct
// array that contains arrays, replace it by three members lineA, lineB, lineC and call the same
// functions on each; nothing else depends on the array.

processor RE_BODY [[ main ]]
{
    // BEGIN ENDPOINTS (generated from plugin/spec.json)
    input stream float<2> in;
    output stream float<2> out;
    input event float param1 [[ name: "A Tune", min: 0.0, max: 100.0, init: 58.0, step: 0.1, unit: "%" ]];
    input event float param2 [[ name: "A Decay", min: 0.0, max: 100.0, init: 50.0, step: 0.1, unit: "%" ]];
    input event float param3 [[ name: "Mix", min: 0.0, max: 100.0, init: 45.0, step: 0.1, unit: "%" ]];
    input event float param4 [[ name: "A Morph", min: 0.0, max: 10.0, init: 7.0, step: 0.001 ]];
    input event float param5 [[ name: "Bypass", min: 0.0, max: 1.0, init: 0.0, step: 1.0, text: "Off|On" ]];
    input event float param6 [[ name: "Width", min: 0.0, max: 100.0, init: 50.0, step: 0.1, unit: "%" ]];
    input event float param7 [[ name: "Low Cut", min: 20.0, max: 500.0, init: 20.0, step: 1.0, unit: "Hz" ]];
    input event float param8 [[ name: "A Enable", min: 0.0, max: 1.0, init: 1.0, step: 1.0, text: "Off|On" ]];
    input event float param9 [[ name: "A Level", min: -60.0, max: 6.0, init: 0.0, step: 0.1, unit: "dB" ]];
    input event float param10 [[ name: "A Listen", min: 0.0, max: 6.0, init: 0.0, step: 1.0, text: "All|Transient|Sustain|Low|Mid|High|Chain" ]];
    input event float param11 [[ name: "A Sensitivity", min: 0.0, max: 100.0, init: 50.0, step: 0.1, unit: "%" ]];
    input event float param12 [[ name: "A Excite", min: 0.0, max: 3.0, init: 0.0, step: 1.0, text: "Through|Hammer|Pluck|Breath" ]];
    input event float param13 [[ name: "A Touch", min: 0.0, max: 100.0, init: 50.0, step: 0.1, unit: "%" ]];
    input event float param14 [[ name: "A Material", min: 0.0, max: 100.0, init: 50.0, step: 0.1, unit: "%" ]];
    input event float param15 [[ name: "A Size", min: -100.0, max: 100.0, init: 0.0, step: 0.1, unit: "%" ]];
    input event float param16 [[ name: "A Position", min: 0.0, max: 100.0, init: 50.0, step: 0.1, unit: "%" ]];
    input event float param17 [[ name: "A Bright", min: 0.0, max: 100.0, init: 50.0, step: 0.1, unit: "%" ]];
    input event float param18 [[ name: "A Body", min: 0.0, max: 100.0, init: 50.0, step: 0.1, unit: "%" ]];
    input event float param19 [[ name: "A Stretch", min: -100.0, max: 100.0, init: 0.0, step: 0.1, unit: "%" ]];
    input event float param20 [[ name: "A Stiffness", min: 0.0, max: 100.0, init: 50.0, step: 0.1, unit: "%" ]];
    input event float param21 [[ name: "A Coupling", min: 0.0, max: 100.0, init: 50.0, step: 0.1, unit: "%" ]];
    input event float param22 [[ name: "A Air", min: 0.0, max: 100.0, init: 50.0, step: 0.1, unit: "%" ]];
    input event float param23 [[ name: "A Reed", min: 0.0, max: 100.0, init: 50.0, step: 0.1, unit: "%" ]];
    input event float param24 [[ name: "A Follow", min: 0.0, max: 100.0, init: 0.0, step: 0.1, unit: "%" ]];
    input event float param25 [[ name: "A Hold", min: 0.0, max: 1.0, init: 0.0, step: 1.0, text: "Off|On" ]];
    input event float param26 [[ name: "A Blend", min: 0.0, max: 100.0, init: 0.0, step: 0.1, unit: "%" ]];
    input event float param27 [[ name: "A Pan", min: -100.0, max: 100.0, init: 0.0, step: 0.1, unit: "%" ]];
    input event float param28 [[ name: "B Tune", min: 0.0, max: 100.0, init: 58.0, step: 0.1, unit: "%" ]];
    input event float param29 [[ name: "B Decay", min: 0.0, max: 100.0, init: 50.0, step: 0.1, unit: "%" ]];
    input event float param30 [[ name: "B Morph", min: 0.0, max: 10.0, init: 0.0, step: 0.001 ]];
    input event float param31 [[ name: "B Enable", min: 0.0, max: 1.0, init: 0.0, step: 1.0, text: "Off|On" ]];
    input event float param32 [[ name: "B Level", min: -60.0, max: 6.0, init: 0.0, step: 0.1, unit: "dB" ]];
    input event float param33 [[ name: "B Listen", min: 0.0, max: 6.0, init: 1.0, step: 1.0, text: "All|Transient|Sustain|Low|Mid|High|Chain" ]];
    input event float param34 [[ name: "B Sensitivity", min: 0.0, max: 100.0, init: 50.0, step: 0.1, unit: "%" ]];
    input event float param35 [[ name: "B Excite", min: 0.0, max: 3.0, init: 0.0, step: 1.0, text: "Through|Hammer|Pluck|Breath" ]];
    input event float param36 [[ name: "B Touch", min: 0.0, max: 100.0, init: 50.0, step: 0.1, unit: "%" ]];
