// RE-BODY analysis: coefficient helpers, one novelty detector per line (T9) and, since P4b, the shared
// analysis stage of concept section 13: the transient/sustain + LR4 3-band Splitter and the YIN PitchTracker.
// Plain structs and functions only, no processors; the caller owns one Splitter and one PitchTracker for the
// whole plug-in (host rate, shared by the three lines).
//
// Every divisor below is provably non-zero (max(..., epsilon)); every cutoff is clamped to 0.45 * sr (P03 2b).
// Nothing in a per-sample path calls a transcendental: exp/sin/cos/tan/pow/log run in prepare() and in the
// control-rate helpers only.
//
// ---- P4b API (namespace rebody::analysis) ---------------------------------------------------------------
// Splitter (20 section 13, review E14):
//   void prepare (Splitter& s, float sr)           coefficients from sr, state cleared
//   void step (Splitter& s, float<2> x)             one host sample; then read the fields
//     s.all        the input x (Listen = All)
//     s.transient  x * g          g = clamp((fast - 1.2 slow) / (fast + 1e-6), 0, 1), smoothed 2 ms; fast and
//     s.sustain    x - transient  slow are stereo-linked (max |L|, |R|) attack/release followers 1/20 ms and
//                                 20/150 ms. transient + sustain == x up to one float rounding (< 1e-7 at |x| <= 1).
//                                 The split amplitude-modulates at 1-20 ms rates (E14): an exciter, not a clean
//                                 separation. Steady pads give g = 0 (sine 60 Hz-2 kHz, noise); a 10 ms 1 kHz
//                                 click peaks at g 0.55 in silence and 0.37 on top of a pad (28 % / 6 % of its
//                                 energy lands in Transient: the slow follower's 20 ms attack catches up).
//     s.low        AP2k(LR4 low-pass 200 Hz (x))                Linkwitz-Riley 4th order = two cascaded
//     s.mid        LR4 low-pass 2 kHz (LR4 high-pass 200 Hz (x))  Butterworth (Q 0.7071) biquads per side;
//     s.high       LR4 high-pass 2 kHz (LR4 high-pass 200 Hz (x)) low + mid + high = AP2k(AP200(x)), an allpass
//                                 (magnitude-flat, not phase-flat). AP2k is the RBJ allpass at 2 kHz, Q 0.7071,
//                                 which equals LR4 LP + HP at 2 kHz exactly under the bilinear transform.
//   float<2> listened (Splitter& s, int listen)     Listen 0 All, 1 Transient, 2 Sustain, 3 Low, 4 Mid, 5 High;
//                                                   anything else (6 = Chain, the caller's) returns s.all
//   float<6> analysisFrame (Splitter& s, PitchTracker& t)  analysisViz: RMS (110 ms) of transient, sustain,
//                                                   low, mid, high (mean over L/R) and the tracker confidence
// Biquad helpers (also usable elsewhere): BiquadCoefficients biquadDesign (int type 0 LP / 1 HP / 2 AP, hz, q, sr)
//   (RBJ, float64 inside, prepare time); Biquad2 (stereo) / Biquad1 (mono) = coefficients + TDF-II state;
//   biquadSet (q, coefficients) clears the state; biquadStep (q, x) per sample (5 mul + 4 add per channel).
// PitchTracker (20 section 13, review E9):
//   void prepare (PitchTracker& t, float sr)        coefficients, lag range, buffers cleared, enabled = false
//   void setEnabled (PitchTracker& t, bool on)      rising edge restarts the analysis (no stale frame, no stale
//                                                   history); falling edge reports confidence 0. While t.enabled
//                                                   is false push() and work() return at once and change nothing.
//   void push (PitchTracker& t, float mono)         every host sample (conditioned mono input, e.g. (L + R) / 2)
//   void work (PitchTracker& t)                     every 32 host samples (the control tick)
//   float hz (PitchTracker& t)                      median of the last 3 voiced estimates in Hz, 0 = none yet
//   float confidence (PitchTracker& t)              1 - d'(tau) of the latest frame, 0..1
//   Pipeline: 4th-order Butterworth anti-alias low-pass at 0.21 x the decimated rate (2.52 kHz at 48 kHz; two
//   biquads, host rate) -> keep every factor-th sample, factor = round(sr / 12 kHz) (4 at 44.1/48 kHz, 8 at 96 kHz,
//   16 at 192 kHz) -> ring buffer 1024. Aliasing into 40 Hz-1.2 kHz: the closest image band starts at
//   rate - 1.2 kHz (10.8 kHz at 48 kHz), where the low-pass is -56.8 dB (48 kHz; -56.3 at 44.1, -52.0 at 96,
//   -50.9 at 192 kHz), so every alias stays below -50 dB; the pass band loses 0.01-0.02 dB at 1.2 kHz.
//   Every 128 decimated samples (hop) the newest window + maxLag samples are copied into a frame; YIN difference
//   d(tau) = E0 + E(tau) - 2 r(tau) over a 512-sample window for tau = 1 .. maxLag (maxLag = rate / 40 Hz + 2,
//   302 at 12 kHz; minLag = rate / 1200 Hz, 10 at 12 kHz), r in float, the energies in float64 (sliding).
//   work() computes a fixed slice of ceil(maxLag / (calls per hop - 1)) lags per call (21 at 48 kHz, 16 calls per
//   hop), so one frame is finished after at most 15 calls; the last call adds the cumulative-mean normalisation
//   d', the absolute threshold 0.15 (first dip, then down to its local minimum; no dip -> global minimum),
//   parabolic interpolation of the lag on d (raw difference: < 0.5 ct error 40 Hz-1.2 kHz without noise; on d'
//   it would be 2-8 ct high above 800 Hz), confidence = 1 - d'(tau), and a gate: only frames with confidence
//   >= 0.5 enter the median-of-3 history, so hz() holds the last voiced pitch through noise and silence.
//   Latency at 48 kHz (from the first sample of a tone after enable): frame = 512 + 302 = 814 decimated samples =
//   67.8 ms, + at most 15 work calls = 10.0 ms -> first estimate after <= 77.8 ms (measured: 77.3 ms, with the
//   work() phase of the tests); then one estimate per hop = 10.7 ms. Until 3 voiced estimates exist hz() is the
//   latest one; afterwards the median of 3 follows a pitch step one hop after the frames see it. A cold start
//   with Follow therefore reaches its target by about 78 ms + the caller's 40 ms glide (gate: 150 ms).
//
// ---- State size (floats; int and bool count as one, float64 as two) ------------------------------------------
//   Splitter: 6 x 2 outputs + 3 envelopes + 6 slews + 9 biquads x (5 coefficients + 4 state) + 5 powers = 107
//   PitchTracker: ring 1024 + frame 832 + d 320 + history 3 + 2 biquads x 7 + 2 float64 + 18 scalars = 2215
//                 (8.9 KB, one per plug-in); trackerFinish uses a 320-float local array.
// ---- Per-sample cost at 48 kHz (flops) -------------------------------------------------------------------
//   Splitter: envelopes and gain about 20 + 1 division, split 4, 9 stereo biquads 162, meters 25 = about 210.
//   PitchTracker while enabled: anti-alias 18 per host sample + the frame copy (814 per hop, 1.6 per sample); per
//   hop 302 lags x 512 x 2 = 309 k flops spread over 15 calls (21.5 k flops per work call, once per 32 samples)
//   + 0.5 k window energy (float64) + about 2 k finish = about 630 flops/sample on average at 48 kHz (the
//   review's 600). Disabled: one bool test per push() and per work() call. The work per second is independent
//   of sr (10 lags per call at 96 kHz, twice as many calls).

namespace rebody::analysis
{
    // Smallest time constant / sample rate used inside divisors.
    const float epsilon = 0.00001f;

    // Replace NaN/Inf by 0 (BODY:587 input guard).
    float finiteOrZero (float v)
    {
        if (isnan (v) || isinf (v))
            return 0.0f;

        return v;
    }

    // Clamp a cutoff or tone frequency to 1 Hz .. 0.45 * sr.
    float limitHz (float hz, float sr)
    {
        return clamp (hz, 1.0f, 0.45f * max (sr, 1000.0f));
    }

    // One-pole low-pass coefficient for y += a * (x - y) from a cutoff in Hz (BODY:520).
    float onePoleCoefficient (float hz, float sr)
    {
        return 1.0f - float (exp (-float (twoPi) * limitHz (hz, sr) / max (sr, 1000.0f)));
    }

    // Per-sample slew coefficient for y += a * (target - y) with time constant `seconds`
    // (BODY:513 onsetRise/onsetFall, 510 fastSlew).
    float slewCoefficient (float seconds, float sr)
    {
        return 1.0f - float (exp (-1.0f / (max (seconds, epsilon) * max (sr, 1000.0f))));
    }

    // Slew coefficient for a control that is stepped once per `ticks` samples (BODY:509).
    float tickSlewCoefficient (float seconds, float sr, int ticks)
    {
        return 1.0f - float (exp (-float (max (ticks, 1)) / (max (seconds, epsilon) * max (sr, 1000.0f))));
    }

    // Per-sample release multiplier for y = max(x, y * r) peak followers (BODY:512 peakRelease).
    float releaseMultiplier (float seconds, float sr)
    {
        return float (exp (-1.0f / (max (seconds, epsilon) * max (sr, 1000.0f))));
    }

    // Pole radius of the 1-pole DC blocker y = x - x[-1] + r * y[-1] (BODY:511).
    float dcBlockRadius (float hz, float sr)
    {
        return float (exp (-float (twoPi) * limitHz (hz, sr) / max (sr, 1000.0f)));
    }

    float dbToGain (float db)
    {
        return float (pow (10.0f, 0.05f * db));
    }

    // Sensitivity 0..100 to linear gain: 0 -> -24 dB, 50 -> 0 dB (unity), 100 -> +24 dB (concept 13).
    float sensitivityGain (float percent)
    {
        return dbToGain ((clamp (percent, 0.0f, 100.0f) - 50.0f) * 0.48f);
    }

    // One step of an attack/release envelope: rise towards a higher target, fall towards a lower one.
    float envelopeStep (float envelope, float target, float riseCoefficient, float fallCoefficient)
    {
        float coefficient = target > envelope ? riseCoefficient : fallCoefficient;
        return envelope + coefficient * (target - envelope);
    }

    // Peak follower with exponential release (BODY:591 peak).
    float peakStep (float peak, float level, float release)
    {
        return max (level, peak * release);
    }

    // BODY's novelty measure (BODY:591): how far the fast peak sits above the slow peak, gated
    // by an absolute level so silence never reports an onset. Result 0..1.
    float novelty (float peak, float slowPeak)
    {
        float relative = clamp ((peak - 1.2f * slowPeak - 0.0015f) / (max (peak, 0.0f) + 0.012f), 0.0f, 1.0f);
        float gate = float (sqrt (clamp ((peak - 0.0015f) / 0.08f, 0.0f, 1.0f)));
        return relative * gate;
    }

    // Onset detector state: one per line, run on that line's listened signal (T9).
    struct OnsetState
    {
        float peak;
        float slowPeak;
        float novelty;
        float onset;
    }

    // Detector time constants (BODY:512-513): peak release 60 ms, slow follower 18 ms,
    // onset rise 0.35 ms, onset fall 50 ms.
    struct OnsetCoefficients
    {
        float peakRelease;
        float slowSlew;
        float rise;
        float fall;
    }

    OnsetCoefficients onsetCoefficients (float sr)
    {
        OnsetCoefficients c;
        c.peakRelease = releaseMultiplier (0.06f, sr);
        c.slowSlew = slewCoefficient (0.018f, sr);
        c.rise = slewCoefficient (0.00035f, sr);
        c.fall = slewCoefficient (0.05f, sr);
        return c;
    }

    // One sample of the detector (BODY:591-594). `level` is the rectified listened signal (>= 0).
    void onsetStep (OnsetState& s, OnsetCoefficients c, float level)
    {
        s.peak = peakStep (s.peak, level, c.peakRelease);
        s.slowPeak += c.slowSlew * (s.peak - s.slowPeak);
        s.novelty = novelty (s.peak, s.slowPeak);
        s.onset = envelopeStep (s.onset, s.novelty, c.rise, c.fall);

        if (s.onset < 0.000001f && s.novelty == 0.0f)
            s.onset = 0.0f;
    }

    void onsetReset (OnsetState& s)
    {
        s.peak = 0.0f;
        s.slowPeak = 0.0f;
        s.novelty = 0.0f;
        s.onset = 0.0f;
    }

    // ---- P2 additions: shared helpers for the line engines and the telemetry meters ------------------------

    // Phase delay in samples of the one-pole low-pass y += a (x - y) at angular frequency omega (BODY:236).
    // Used to tune the loops: delay = sr / hz - phase delay of every filter inside the loop. The divisor
    // 1 - (1 - a) cos(w) is at least a > 0.
    float filterPhaseDelay (float coefficient, float omega)
    {
        float w = max (omega, 0.0001f);
        float keep = 1.0f - clamp (coefficient, 0.0f, 1.0f);
        return float (atan (keep * float (sin (w)) / max (1.0f - keep * float (cos (w)), 0.000001f))) / w;
    }

    // Phase delay in samples of the first-order allpass y = d x + s, s' = x - d y (piano dispersion,
    // BODY:352-358): 2 atan(((1 - d) / (1 + d)) tan(w / 2)) / w. d = 0 is a pure one-sample delay (= 1.0).
    float allpassPhaseDelay (float d, float omega)
    {
        float w = max (omega, 0.0001f);
        float c = clamp (d, -0.95f, 0.95f);
        float ratio = (1.0f - c) / (1.0f + c);
        return 2.0f * float (atan (ratio * float (tan (0.5f * w)))) / w;
    }

    // Smoothstep 0..1 (BODY:131, :242, :712 easing of the hybrid segment).
    float smoothstep01 (float t)
    {
        float u = clamp (t, 0.0f, 1.0f);
        return u * u * (3.0f - 2.0f * u);
    }

    // One control-rate slew step with exact convergence (BODY:226-250 idiom): the value lands on the
    // target instead of approaching it for ever.
    float slewTo (float value, float target, float slew)
    {
        float next = value + slew * (target - value);

        if (next == value || abs (next - target) < 0.000001f)
            next = target;

        return next;
    }

    // xorshift32 noise (BODY:624-625); a zero state would stick, so it is re-seeded.
    int xorshift (int state)
    {
        int s = state;

        if (s == 0)
            s = 1234567;

        s ^= s << 13;
        s ^= s >> 17;
        s ^= s << 5;
        return s;
    }

    // Noise -1..1 from a xorshift state.
    float noiseOf (int state)
    {
        return float (state & 0x7fffffff) / 1073741824.0f - 1.0f;
    }

    // Listened component of the conditioned input for one line (concept 13). P2 carries Listen = All
    // only; Transient/Sustain/Low/Mid/High (P4b split) and Chain (previous line) return the input.
    float<2> listenComponent (int mode, float<2> x)
    {
        return x;
    }

    // Linear ramp of one value across a control tick (BODY idiom: target set at the tick, linear steps
    // per sample, snap at the next tick). `now` is what the sample loop reads after rampNext().
    struct Ramp
    {
        float now;
        float target;
        float step;
    }

    // Set a new target at the tick. `snap` jumps straight there (first tick); otherwise the previous
    // ramp is finished first and the new one runs over `ticks` samples.
    void rampSet (Ramp& r, float target, bool snap, int ticks)
    {
        if (snap)
        {
            r.now = target;
            r.target = target;
            r.step = 0.0f;
        }
        else
        {
            r.now = r.target;
            r.target = target;
            r.step = (target - r.now) / float (max (ticks, 1));
        }
    }

    // Finish the running ramp without a new target (value held, step 0).
    void rampFinish (Ramp& r)
    {
        r.now = r.target;
        r.step = 0.0f;
    }

    float rampNext (Ramp& r)
    {
        r.now += r.step;
        return r.now;
    }

    // Eight octave band meters on the wet sum (bodyBands, b60 .. b7680): seven one-pole low-passes at the
    // band edges 60 x 2^(k + 1/2) and the differences between neighbours; band 0 is the first low-pass,
    // band 7 is the rest above the last edge. Each band keeps a smoothed power (110 ms).
    struct BandMeters
    {
        float[7] lowpass;
        float[8] power;
    }

    struct BandCoefficients
    {
        float[7] edge;
        float powerSlew;
    }

    void bandCoefficients (BandCoefficients& c, float sr)
    {
        for (int k = 0; k < 7; k += 1)
            c.edge.at (k) = onePoleCoefficient (60.0f * float (pow (2.0f, float (k) + 0.5f)), sr);

        c.powerSlew = slewCoefficient (0.11f, sr);
    }

    void bandStep (BandMeters& m, BandCoefficients& c, float sample)
    {
        float previous = 0.0f;

        for (int k = 0; k < 7; k += 1)
        {
            m.lowpass.at (k) += c.edge.at (k) * (sample - m.lowpass.at (k));
            float band = m.lowpass.at (k) - previous;
            m.power.at (k) += c.powerSlew * (band * band - m.power.at (k));
            previous = m.lowpass.at (k);
        }

        float top = sample - previous;
        m.power.at (7) += c.powerSlew * (top * top - m.power.at (7));
    }

    // Band amplitudes (RMS) for the telemetry frame; tiny values are flushed to zero.
    float<8> bandLevels (BandMeters& m)
    {
        float<8> v = float<8> (0.0f);

        for (int k = 0; k < 8; k += 1)
        {
            float p = m.power.at (k);
            v.at (k) = p > 1.0e-18f ? float (sqrt (p)) : 0.0f;
        }

        return v;
    }

    // ---- P4b: shared analysis stage (concept 13) -------------------------------------------------------------

    // Biquad coefficients, normalised so a0 = 1 (RBJ cookbook, bilinear transform prewarped at hz).
    struct BiquadCoefficients
    {
        float b0, b1, b2, a1, a2;
    }

    // Stereo and mono biquad sections, transposed direct form II.
    struct Biquad2
    {
        BiquadCoefficients c;
        float<2> z1, z2;
    }

    struct Biquad1
    {
        BiquadCoefficients c;
        float z1, z2;
    }

    const int biquadLowpass = 0;
    const int biquadHighpass = 1;
    const int biquadAllpass = 2;
    const float butterworthQ = 0.70710678f;

    // One biquad design in float64 (prepare time only). `q` is clamped to >= 0.05, hz to 1 Hz .. 0.45 sr.
    BiquadCoefficients biquadDesign (int type, float hz, float q, float sr)
    {
        float64 w0 = twoPi * float64 (limitHz (hz, sr)) / float64 (max (sr, 1000.0f));
        float64 cw = cos (w0);
        float64 alpha = sin (w0) / (2.0 * float64 (max (q, 0.05f)));
        float64 a0 = 1.0 + alpha;
        float64 b0 = 1.0 - alpha;
        float64 b1 = -2.0 * cw;
        float64 b2 = 1.0 + alpha;

        if (type == biquadLowpass)
        {
            b0 = 0.5 * (1.0 - cw);
            b1 = 1.0 - cw;
            b2 = b0;
        }
        else if (type == biquadHighpass)
        {
            b0 = 0.5 * (1.0 + cw);
            b1 = -(1.0 + cw);
            b2 = b0;
        }

        BiquadCoefficients c;
        c.b0 = float (b0 / a0);
        c.b1 = float (b1 / a0);
        c.b2 = float (b2 / a0);
        c.a1 = float (-2.0 * cw / a0);
        c.a2 = float ((1.0 - alpha) / a0);
        return c;
    }

    void biquadSet (Biquad2& q, BiquadCoefficients c)
    {
        q.c = c;
        q.z1 = float<2> (0.0f);
        q.z2 = float<2> (0.0f);
    }

    void biquadSet (Biquad1& q, BiquadCoefficients c)
    {
        q.c = c;
        q.z1 = 0.0f;
        q.z2 = 0.0f;
    }

    float<2> biquadStep (Biquad2& q, float<2> x)
    {
        float<2> y = q.c.b0 * x + q.z1;
        q.z1 = q.c.b1 * x - q.c.a1 * y + q.z2;
        q.z2 = q.c.b2 * x - q.c.a2 * y;
        return y;
    }

    float biquadStep (Biquad1& q, float x)
    {
        float y = q.c.b0 * x + q.z1;
        q.z1 = q.c.b1 * x - q.c.a1 * y + q.z2;
        q.z2 = q.c.b2 * x - q.c.a2 * y;
        return y;
    }

    // ---- Splitter: transient/sustain and LR4 3-band split -------------------------------------------------

    const float splitK = 1.2f;                 // slow-envelope weight: steady pads give g = 0 (BODY's 1.2, :591)
    const float splitEpsilon = 0.000001f;      // keeps g finite and 0 in silence
    const float splitLowHz = 200.0f;
    const float splitHighHz = 2000.0f;

    struct Splitter
    {
        float<2> all, transient, sustain, low, mid, high;
        float fast, slow, gain;                // linked envelopes and the smoothed transient gain
        float fastRise, fastFall, slowRise, slowFall, gainSlew, powerSlew;
        Biquad2[2] low200, high200, low2k, high2k;
        Biquad2 allpass2k;
        float[5] power;                        // 110 ms power of transient, sustain, low, mid, high (analysisViz)
    }

    void prepare (Splitter& s, float sr)
    {
        s.all = float<2> (0.0f);
        s.transient = float<2> (0.0f);
        s.sustain = float<2> (0.0f);
        s.low = float<2> (0.0f);
        s.mid = float<2> (0.0f);
        s.high = float<2> (0.0f);
        s.fast = 0.0f;
        s.slow = 0.0f;
        s.gain = 0.0f;
        s.fastRise = slewCoefficient (0.001f, sr);
        s.fastFall = slewCoefficient (0.020f, sr);
        s.slowRise = slewCoefficient (0.020f, sr);
        s.slowFall = slewCoefficient (0.150f, sr);
        s.gainSlew = slewCoefficient (0.002f, sr);
        s.powerSlew = slewCoefficient (0.11f, sr);

        BiquadCoefficients lowA = biquadDesign (biquadLowpass, splitLowHz, butterworthQ, sr);
        BiquadCoefficients highA = biquadDesign (biquadHighpass, splitLowHz, butterworthQ, sr);
        BiquadCoefficients lowB = biquadDesign (biquadLowpass, splitHighHz, butterworthQ, sr);
        BiquadCoefficients highB = biquadDesign (biquadHighpass, splitHighHz, butterworthQ, sr);

        for (int k = 0; k < 2; k += 1)
        {
            biquadSet (s.low200.at (k), lowA);
            biquadSet (s.high200.at (k), highA);
            biquadSet (s.low2k.at (k), lowB);
            biquadSet (s.high2k.at (k), highB);
        }

        biquadSet (s.allpass2k, biquadDesign (biquadAllpass, splitHighHz, butterworthQ, sr));

        for (int k = 0; k < 5; k += 1)
            s.power.at (k) = 0.0f;
    }

    float meanPower (float<2> v)
    {
        return 0.5f * (v[0] * v[0] + v[1] * v[1]);
    }

    void step (Splitter& s, float<2> x)
    {
        s.all = x;

        float level = max (abs (x[0]), abs (x[1]));
        s.fast = envelopeStep (s.fast, level, s.fastRise, s.fastFall);
        s.slow = envelopeStep (s.slow, level, s.slowRise, s.slowFall);
        float g = clamp ((s.fast - splitK * s.slow) / (s.fast + splitEpsilon), 0.0f, 1.0f);
        s.gain += s.gainSlew * (g - s.gain);

        s.transient = x * s.gain;
        s.sustain = x - s.transient;

        float<2> lowPart = biquadStep (s.low200.at (1), biquadStep (s.low200.at (0), x));
        float<2> highPart = biquadStep (s.high200.at (1), biquadStep (s.high200.at (0), x));
        s.low = biquadStep (s.allpass2k, lowPart);
        s.mid = biquadStep (s.low2k.at (1), biquadStep (s.low2k.at (0), highPart));
        s.high = biquadStep (s.high2k.at (1), biquadStep (s.high2k.at (0), highPart));

        s.power.at (0) += s.powerSlew * (meanPower (s.transient) - s.power.at (0));
        s.power.at (1) += s.powerSlew * (meanPower (s.sustain) - s.power.at (1));
        s.power.at (2) += s.powerSlew * (meanPower (s.low) - s.power.at (2));
        s.power.at (3) += s.powerSlew * (meanPower (s.mid) - s.power.at (3));
        s.power.at (4) += s.powerSlew * (meanPower (s.high) - s.power.at (4));
    }

    // The Splitter field a line listens to (Listen 0..5); Chain (6) is the caller's, it returns the input here.
    float<2> listened (Splitter& s, int listen)
    {
        if (listen == 1) return s.transient;
        if (listen == 2) return s.sustain;
        if (listen == 3) return s.low;
        if (listen == 4) return s.mid;
        if (listen == 5) return s.high;
        return s.all;
    }

    // ---- PitchTracker: decimated YIN with the work spread over the hop -------------------------------------

    const float trackerRate = 12000.0f;        // target decimated rate
    const int trackerWindow = 512;
    const int trackerHop = 128;                // decimated samples between frames
    const int trackerRingSize = 1024;          // power of two >= window + max lag
    const int trackerRingMask = 1023;
    const int trackerLagLimit = 318;           // largest maxLag (keeps tau + 1 inside the arrays)
    const int trackerFrameSize = 832;          // window + trackerLagLimit + 2
    const int trackerWorkPeriod = 32;          // host samples between work() calls (the control tick)
    const float trackerLowHz = 40.0f;
    const float trackerHighHz = 1200.0f;
    const float trackerThreshold = 0.15f;      // YIN absolute threshold on d'
    const float trackerGate = 0.5f;            // minimum confidence for a frame to enter the median history
    const float trackerAntiAlias = 0.21f;      // anti-alias cutoff as a fraction of the decimated rate
    const float butterworth4Q1 = 0.54119610f;  // 1 / (2 cos(pi / 8))
    const float butterworth4Q2 = 1.30656296f;  // 1 / (2 cos(3 pi / 8))

    struct PitchTracker
    {
        bool enabled;
        int factor;                            // decimation factor
        int phase;                             // host samples since the last kept sample
        float rate;                            // decimated rate
        int minLag, maxLag, frameLength, lagsPerCall;
        Biquad1[2] antiAlias;
        float[trackerRingSize] ring;
        int write;                             // next ring index
        int filled;                            // decimated samples since (re)start, saturating
        int sinceFrame;                        // decimated samples since the last frame was taken
        float[trackerFrameSize] frame;
        bool pending;                          // a frame is being analysed
        int cursor;                            // next lag to compute (1 = frame not started)
        float64 energy0, energyLag;            // window energy at lag 0 and at the current lag
        float[trackerLagLimit + 2] diff;       // d(tau), tau = 0 .. maxLag
        float[3] history;
        int historyCount, historyIndex;
        float hzOut, confidenceOut, frameHz;
    }

    void trackerRestart (PitchTracker& t)
    {
        t.phase = 0;
        t.write = 0;
        t.filled = 0;
        t.sinceFrame = trackerHop;
        t.pending = false;
        t.cursor = 1;
        t.energy0 = 0.0;
        t.energyLag = 0.0;
        t.historyCount = 0;
        t.historyIndex = 0;
        t.hzOut = 0.0f;
        t.confidenceOut = 0.0f;
        t.frameHz = 0.0f;

        for (int k = 0; k < 2; k += 1)
        {
            t.antiAlias.at (k).z1 = 0.0f;
            t.antiAlias.at (k).z2 = 0.0f;
        }

        for (int i = 0; i < trackerRingSize; i += 1)
            t.ring.at (i) = 0.0f;

        for (int i = 0; i < trackerFrameSize; i += 1)
            t.frame.at (i) = 0.0f;

        for (int i = 0; i < trackerLagLimit + 2; i += 1)
            t.diff.at (i) = 0.0f;

        for (int i = 0; i < 3; i += 1)
            t.history.at (i) = 0.0f;
    }

    void prepare (PitchTracker& t, float sr)
    {
        float hostRate = max (sr, 1000.0f);
        t.factor = clamp (int (hostRate / trackerRate + 0.5f), 1, 16);
        t.rate = hostRate / float (t.factor);
        t.minLag = max (2, int (t.rate / trackerHighHz));
        t.maxLag = clamp (int (t.rate / trackerLowHz) + 2, t.minLag + 2, trackerLagLimit);
        t.frameLength = trackerWindow + t.maxLag;
        int calls = max (2, trackerHop * t.factor / trackerWorkPeriod);
        t.lagsPerCall = (t.maxLag + calls - 2) / (calls - 1);

        float cutoff = trackerAntiAlias * t.rate;
        biquadSet (t.antiAlias.at (0), biquadDesign (biquadLowpass, cutoff, butterworth4Q1, hostRate));
        biquadSet (t.antiAlias.at (1), biquadDesign (biquadLowpass, cutoff, butterworth4Q2, hostRate));

        t.enabled = false;
        trackerRestart (t);
    }

    void setEnabled (PitchTracker& t, bool on)
    {
        if (on && ! t.enabled)
            trackerRestart (t);

        if (! on)
            t.confidenceOut = 0.0f;

        t.enabled = on;
    }

    void push (PitchTracker& t, float mono)
    {
        if (! t.enabled)
            return;

        float x = biquadStep (t.antiAlias.at (1), biquadStep (t.antiAlias.at (0), finiteOrZero (mono)));
        t.phase += 1;

        if (t.phase < t.factor)
            return;

        t.phase = 0;
        t.ring.at (t.write) = x;
        t.write = (t.write + 1) & trackerRingMask;
        t.filled = min (t.filled + 1, 1 << 24);
        t.sinceFrame = min (t.sinceFrame + 1, 1 << 24);

        if (t.filled >= t.frameLength && t.sinceFrame >= trackerHop)
        {
            int start = (t.write - t.frameLength) & trackerRingMask;

            for (int j = 0; j < t.frameLength; j += 1)
                t.frame.at (j) = t.ring.at ((start + j) & trackerRingMask);

            t.sinceFrame = 0;
            t.pending = true;
            t.cursor = 1;
        }
    }

    float medianOf3 (float a, float b, float c)
    {
        return max (min (a, b), min (max (a, b), c));
    }

    // Last step of a frame: d', threshold, parabolic interpolation, confidence, gated median of 3.
    void trackerFinish (PitchTracker& t)
    {
        float[trackerLagLimit + 2] norm;
        norm.at (0) = 1.0f;
        float64 running = 0.0;

        for (int tau = 1; tau <= t.maxLag; tau += 1)
        {
            float64 d = float64 (t.diff.at (tau));
            running += d;
            norm.at (tau) = running > 1.0e-20 ? float (d * float64 (tau) / running) : 1.0f;
        }

        int best = -1;

        for (int tau = t.minLag; tau < t.maxLag; tau += 1)
        {
            if (norm.at (tau) < trackerThreshold)
            {
                best = tau;
                break;
            }
        }

        if (best >= 0)
        {
            while (best + 1 < t.maxLag && norm.at (best + 1) < norm.at (best))
                best += 1;
        }
        else
        {
            best = t.minLag;

            for (int tau = t.minLag + 1; tau < t.maxLag; tau += 1)
                if (norm.at (tau) < norm.at (best))
                    best = tau;
        }

        float a = t.diff.at (best - 1);
        float b = t.diff.at (best);
        float c = t.diff.at (best + 1);
        float curvature = a - 2.0f * b + c;
        float offset = curvature > 1.0e-30f ? clamp (0.5f * (a - c) / curvature, -1.0f, 1.0f) : 0.0f;
        float conf = clamp (1.0f - norm.at (best), 0.0f, 1.0f);

        t.frameHz = t.rate / max (float (best) + offset, 1.0f);
        t.confidenceOut = conf;

        if (conf >= trackerGate)
        {
            t.history.at (t.historyIndex) = t.frameHz;
            t.historyIndex = (t.historyIndex + 1) % 3;
            t.historyCount = min (t.historyCount + 1, 3);

            if (t.historyCount >= 3)
                t.hzOut = medianOf3 (t.history.at (0), t.history.at (1), t.history.at (2));
            else
                t.hzOut = t.frameHz;
        }
    }

    void work (PitchTracker& t)
    {
        if (! t.enabled || ! t.pending)
            return;

        if (t.cursor <= 1)
        {
            float64 e = 0.0;

            for (int j = 0; j < trackerWindow; j += 1)
            {
                float64 v = float64 (t.frame.at (j));
                e += v * v;
            }

            t.energy0 = e;
            t.energyLag = e;
            t.diff.at (0) = 0.0f;
            t.cursor = 1;
        }

        int last = min (t.cursor + t.lagsPerCall - 1, t.maxLag);

        for (int tau = t.cursor; tau <= last; tau += 1)
        {
            float64 leaving = float64 (t.frame.at (tau - 1));
            float64 entering = float64 (t.frame.at (tau - 1 + trackerWindow));
            t.energyLag += entering * entering - leaving * leaving;

            float r = 0.0f;

            for (int j = 0; j < trackerWindow; j += 1)
                r += t.frame.at (j) * t.frame.at (j + tau);

            t.diff.at (tau) = max (0.0f, float (t.energy0 + t.energyLag - 2.0 * float64 (r)));
        }

        t.cursor = last + 1;

        if (t.cursor > t.maxLag)
        {
            t.pending = false;
            t.cursor = 1;
            trackerFinish (t);
        }
    }

    float hz (PitchTracker& t)
    {
        return t.hzOut;
    }

    float confidence (PitchTracker& t)
    {
        return t.confidenceOut;
    }

    // analysisViz frame: RMS of transient, sustain, low, mid, high and the pitch confidence.
    float<6> analysisFrame (Splitter& s, PitchTracker& t)
    {
        float<6> v = float<6> (0.0f);

        for (int k = 0; k < 5; k += 1)
        {
            float p = s.power.at (k);
            v.at (k) = p > 1.0e-18f ? float (sqrt (p)) : 0.0f;
        }

        v.at (5) = t.enabled ? t.confidenceOut : 0.0f;
        return v;
    }
}
