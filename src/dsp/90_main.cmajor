    input event float param6 [[ name: "Width", min: 0.0, max: 100.0, init: 50.0, step: 0.1, unit: "%" ]];
    input event float param7 [[ name: "Low Cut", min: 20.0, max: 500.0, init: 20.0, step: 1.0, unit: "Hz" ]];
    input event float param8 [[ name: "A Enable", min: 0.0, max: 1.0, init: 1.0, step: 1.0, text: "Off|On" ]];
