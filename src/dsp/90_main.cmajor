    event param53 (float v) { if (!isnan(v) && !isinf(v)) paramTarget.at(52) = clamp(v, rebody::params::minValue.at(52), rebody::params::maxValue.at(52)); } // C Morph
    event param54 (float v) { if (!isnan(v) && !isinf(v)) paramTarget.at(53) = clamp(float(floor(v + 0.5f)), rebody::params::minValue.at(53), rebody::params::maxValue.at(53)); } // C Enable
    event param55 (float v) { if (!isnan(v) && !isinf(v)) paramTarget.at(54) = clamp(v, rebody::params::minValue.at(54), rebody::params::maxValue.at(54)); } // C Level
    event param56 (float v) { if (!isnan(v) && !isinf(v)) paramTarget.at(55) = clamp(float(floor(v + 0.5f)), rebody::params::minValue.at(55), rebody::params::maxValue.at(55)); } // C Listen
    event param57 (float v) { if (!isnan(v) && !isinf(v)) paramTarget.at(56) = clamp(v, rebody::params::minValue.at(56), rebody::params::maxValue.at(56)); } // C Sensitivity
    event param58 (float v) { if (!isnan(v) && !isinf(v)) paramTarget.at(57) = clamp(float(floor(v + 0.5f)), rebody::params::minValue.at(57), rebody::params::maxValue.at(57)); } // C Excite
    event param59 (float v) { if (!isnan(v) && !isinf(v)) paramTarget.at(58) = clamp(v, rebody::params::minValue.at(58), rebody::params::maxValue.at(58)); } // C Touch
    event param60 (float v) { if (!isnan(v) && !isinf(v)) paramTarget.at(59) = clamp(v, rebody::params::minValue.at(59), rebody::params::maxValue.at(59)); } // C Material
    event param61 (float v) { if (!isnan(v) && !isinf(v)) paramTarget.at(60) = clamp(v, rebody::params::minValue.at(60), rebody::params::maxValue.at(60)); } // C Size
    event param62 (float v) { if (!isnan(v) && !isinf(v)) paramTarget.at(61) = clamp(v, rebody::params::minValue.at(61), rebody::params::maxValue.at(61)); } // C Position
    event param63 (float v) { if (!isnan(v) && !isinf(v)) paramTarget.at(62) = clamp(v, rebody::params::minValue.at(62), rebody::params::maxValue.at(62)); } // C Bright
    event param64 (float v) { if (!isnan(v) && !isinf(v)) paramTarget.at(63) = clamp(v, rebody::params::minValue.at(63), rebody::params::maxValue.at(63)); } // C Body
    event param65 (float v) { if (!isnan(v) && !isinf(v)) paramTarget.at(64) = clamp(v, rebody::params::minValue.at(64), rebody::params::maxValue.at(64)); } // C Stretch
    event param66 (float v) { if (!isnan(v) && !isinf(v)) paramTarget.at(65) = clamp(v, rebody::params::minValue.at(65), rebody::params::maxValue.at(65)); } // C Stiffness
    event param67 (float v) { if (!isnan(v) && !isinf(v)) paramTarget.at(66) = clamp(v, rebody::params::minValue.at(66), rebody::params::maxValue.at(66)); } // C Coupling
    event param68 (float v) { if (!isnan(v) && !isinf(v)) paramTarget.at(67) = clamp(v, rebody::params::minValue.at(67), rebody::params::maxValue.at(67)); } // C Air
    event param69 (float v) { if (!isnan(v) && !isinf(v)) paramTarget.at(68) = clamp(v, rebody::params::minValue.at(68), rebody::params::maxValue.at(68)); } // C Reed
    event param70 (float v) { if (!isnan(v) && !isinf(v)) paramTarget.at(69) = clamp(v, rebody::params::minValue.at(69), rebody::params::maxValue.at(69)); } // C Follow
    event param71 (float v) { if (!isnan(v) && !isinf(v)) paramTarget.at(70) = clamp(float(floor(v + 0.5f)), rebody::params::minValue.at(70), rebody::params::maxValue.at(70)); } // C Hold
    event param72 (float v) { if (!isnan(v) && !isinf(v)) paramTarget.at(71) = clamp(v, rebody::params::minValue.at(71), rebody::params::maxValue.at(71)); } // C Blend
    event param73 (float v) { if (!isnan(v) && !isinf(v)) paramTarget.at(72) = clamp(v, rebody::params::minValue.at(72), rebody::params::maxValue.at(72)); } // C Pan
    // END HANDLERS

    // BEGIN TABLES MEMBER (set by tools/build_dsp.py from the emission form of src/dsp/10_tables.cmajor)
    // tables: namespace form, constants are read as rebody::tables::<name>
    // END TABLES MEMBER

    rebody::line::Line[3] lines;
    rebody::line::Protector protector;
    rebody::analysis::BandMeters bandMeters;
    rebody::analysis::BandCoefficients bandCoeffs;

    // Input conditioning, mix and bypass smoothing (BODY:16-30).
    float mixNow, bypassNow;
    float controlTickSlew, morphTickSlew, fastSlew, dcRadius;
    float<2> previousInput, dcState;
    float sampleRate;
    float lowCutNow;
    float widthPercent;                            // smoothed global Width (percent), also read by the lines (P3: in-body Width)
    bool started;
    int counter;

    // Meters and telemetry (BODY:26-27, :893).
    float inputMeter, wetMeter, leftMeter, rightMeter, meterRelease;
    int vizCounter, vizPeriod;

    // Step the 23 block parameters of one line towards the host values and run its control tick (32 samples,
    // BODY:579); `snap` jumps straight to the targets (first sample). Discrete parameters (step >= 1: Enable,
    // Listen, Excite, Hold) switch immediately. Tune and Decay are taken as they are: the shared register slews
    // them (BODY:223-251), smoothing twice would double the lag.
    void controlLine (int k, bool snap)
    {
        for (int s = 0; s < rebody::params::lineSlots; s += 1)
        {
            int index = rebody::params::lineParam.at (k * rebody::params::lineSlots + s);
            float target = paramTarget.at (index);
            float now = lines.at (k).control.at (s);

            if (snap || rebody::params::stepValue.at (index) >= 1.0f
                 || s == rebody::params::slotTune || s == rebody::params::slotDecay)
            {
                now = target;
            }
            else
            {
                float previous = now;
                now += (s == rebody::params::slotMorph ? morphTickSlew : controlTickSlew) * (target - now);

                if (now == previous || abs (now - target) < 0.000001f)
                    now = target;
            }

            lines.at (k).control.at (s) = now;
        }

        lines.at (k).width = widthPercent;
        rebody::line::tick (lines.at (k), snap);
    }

    // Global controls at the tick: Width (mid/side on the wet sum) and Low Cut.
    void controlGlobal (bool snap)
    {
        float lowCutTarget = paramTarget.at (rebody::params::globalLowCut);
        float previous = lowCutNow;
        lowCutNow = snap ? lowCutTarget : lowCutNow + controlTickSlew * (lowCutTarget - lowCutNow);

        if (lowCutNow == previous || abs (lowCutNow - lowCutTarget) < 0.000001f)
            lowCutNow = lowCutTarget;

        rebody::line::setLowCut (protector, lowCutNow, sampleRate);
        rebody::line::setWidth (protector, paramTarget.at (rebody::params::globalWidth), snap);
        widthPercent = rebody::analysis::slewTo (snap ? paramTarget.at (rebody::params::globalWidth) : widthPercent,
                                                 paramTarget.at (rebody::params::globalWidth), controlTickSlew);
    }

    void main()
    {
        float sr = float (processor.frequency);
        sampleRate = sr;

        // Sample-rate derived coefficients (BODY:509-518).
        controlTickSlew = rebody::analysis::tickSlewCoefficient (0.055f, sr, rebody::controlPeriod);
        morphTickSlew = rebody::analysis::tickSlewCoefficient (0.025f, sr, rebody::controlPeriod);
        fastSlew = rebody::analysis::slewCoefficient (0.012f, sr);
        dcRadius = rebody::analysis::dcBlockRadius (20.0f, sr);
        meterRelease = rebody::analysis::releaseMultiplier (0.11f, sr);
        vizPeriod = max (1, int (sr / float (rebody::vizRateHz)));
        rebody::analysis::bandCoefficients (bandCoeffs, sr);

        for (int k = 0; k < rebody::numLines; k += 1)
            rebody::line::initLine (lines.at (k), k, sr);

        rebody::line::initProtector (protector, sr);

        // BEGIN TABLES LOAD (set by tools/build_dsp.py from the emission form of src/dsp/10_tables.cmajor)
        // tables: namespace form, constants are read as rebody::tables::<name>
        // END TABLES LOAD

        loop
        {
            if (! started)
            {
                // Host values set before the first sample are honoured: snap to them.
                for (int k = 0; k < rebody::numLines; k += 1)
                    controlLine (k, true);

                controlGlobal (true);
                mixNow = clamp (paramTarget.at (rebody::params::globalMix) * 0.01f, 0.0f, 1.0f);
                bypassNow = paramTarget.at (rebody::params::globalBypass) >= 0.5f ? 1.0f : 0.0f;
                started = true;
            }

            // Staggered control ticks: line k at sample 11 k of every 32.
            if (counter == 0)
                controlGlobal (false);

            for (int k = 0; k < rebody::numLines; k += 1)
                if (counter == 11 * k)
                    controlLine (k, false);

            counter = (counter + 1) % rebody::controlPeriod;

            float mixTarget = clamp (paramTarget.at (rebody::params::globalMix) * 0.01f, 0.0f, 1.0f);
            float bypassTarget = paramTarget.at (rebody::params::globalBypass) >= 0.5f ? 1.0f : 0.0f;
            float previousMix = mixNow;
            float previousBypass = bypassNow;
            mixNow += fastSlew * (mixTarget - mixNow);
            bypassNow += fastSlew * (bypassTarget - bypassNow);

            if (mixNow == previousMix || abs (mixNow - mixTarget) < 0.000001f)
                mixNow = mixTarget;

            if (bypassNow == previousBypass || abs (bypassNow - bypassTarget) < 0.000001f)
                bypassNow = bypassTarget;

            // Condition the input: NaN/Inf guard, DC block, clamp, bypass fade (BODY:587-590).
            float<2> dry = in;

            for (int ch = 0; ch < 2; ch += 1)
                dry.at (ch) = rebody::analysis::finiteOrZero (dry.at (ch));

            float<2> x = dry - previousInput + dcRadius * dcState;
            previousInput = dry;
            dcState = x;

            for (int ch = 0; ch < 2; ch += 1)
                x.at (ch) = clamp (x.at (ch), -4.0f, 4.0f);

            x *= 1.0f - bypassNow;
            float level = max (abs (x.at (0)), abs (x.at (1)));

            // Lines: each listens to its component of the conditioned input (P2: All) and runs the whole chain.
            bool inputActive = max (abs (dry.at (0)), abs (dry.at (1))) > 0.00001f && bypassNow < 0.5f;
            float<2> wetSum = float<2> (0.0f);

            for (int k = 0; k < rebody::numLines; k += 1)
            {
                if (lines.at (k).dormant && ! lines.at (k).enabled)
                {
                    rebody::line::idleSample (lines.at (k));
                }
                else
                {
                    int listen = int (lines.at (k).control.at (rebody::params::slotListen) + 0.5f);
                    wetSum += rebody::line::process (lines.at (k), rebody::analysis::listenComponent (listen, x), inputActive);
                }

                rebody::line::accumulate (lines.at (k));
            }

            // Sum of lines: Width, Low Cut, wet DC block, shared protector + knee (BODY:857-889).
            wetSum = rebody::line::widthStep (protector, wetSum);
            wetSum = rebody::line::lowCutStep (protector, wetSum);
            wetSum = rebody::line::dcBlockStep (protector, wetSum);
            float<2> wet = rebody::line::protectStep (protector, wetSum, dry);

            if (protector.quietReset)
                for (int k = 0; k < rebody::numLines; k += 1)
                    rebody::line::resetBalance (lines.at (k));

            // Mix is linear as BODY on purpose; bypass fades the wet path out and Mix with it (BODY:890).
            float amount = mixNow * (1.0f - bypassNow);
            float<2> result = dry * (1.0f - amount) + wet * amount;

            if (amount == 0.0f)
                result = dry;

            out <- result;

            inputMeter = max (level, inputMeter * meterRelease);
            leftMeter = max (abs (wet.at (0)), leftMeter * meterRelease);
            rightMeter = max (abs (wet.at (1)), rightMeter * meterRelease);
            wetMeter = max (leftMeter, rightMeter);

            if (inputMeter < 0.000000001f) inputMeter = 0.0f;
            if (leftMeter < 0.000000001f) leftMeter = 0.0f;
            if (rightMeter < 0.000000001f) rightMeter = 0.0f;

            rebody::analysis::bandStep (bandMeters, bandCoeffs, 0.5f * (wet.at (0) + wet.at (1)));

            vizCounter += 1;

            if (vizCounter >= vizPeriod)
            {
                vizCounter = 0;

                // Shared onset: strongest line onset since the last frame (peak hold).
                float onsetMax = max (lines.at (0).onsetHold, max (lines.at (1).onsetHold, lines.at (2).onsetHold));

                bodyViz <- float<4> (inputMeter, wetMeter, leftMeter, rightMeter);
                bodyBands <- rebody::analysis::bandLevels (bandMeters);
                bodyOnset <- onsetMax;
                // P2: transient, sustain, low, mid and high report the input energy until the P4b split exists.
                analysisViz <- float<6> (inputMeter, inputMeter, inputMeter, inputMeter, inputMeter, 0.0f);
                lineStateA <- rebody::line::takeState (lines.at (0));
                lineStateB <- rebody::line::takeState (lines.at (1));
                lineStateC <- rebody::line::takeState (lines.at (2));
                lineModesA <- rebody::line::modesState (lines.at (0));
                lineModesB <- rebody::line::modesState (lines.at (1));
                lineModesC <- rebody::line::modesState (lines.at (2));
            }

            advance();
        }
    }
}
