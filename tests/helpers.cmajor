// RE-BODY: imaginary instrument bodies excited by incoming audio (Amorph FX, Cmajor).
// Based on BODY by Artists in DSP; rebuilt on physically modelled bodies with three
// independent lines (docs/concept/20_DSP_CONCEPT.md, parameters in plugin/spec.json).
// Exploratory models, not acoustic instrument emulations.
//
// This file is one part of plugin/dsp.cmajor, which tools/build_dsp.py concatenates from
// src/dsp/*.cmajor in filename order (Cmajor has no imports; namespaces may be split
// across parts). Parts: 00 header, 10 tables (generated by tools/bodytab.py), 20 analysis,
// 30 strikers, 40 modal, 50 line, 90 main.

namespace rebody
{
    // Three identical lines A, B, C, each a complete BODY-style chain (concept 20 section 12).
    const int numLines = 3;
    // Anchor bodies in Morph order 0..10 (spec.json anchors): Bass Drum, Snare, Timpani, Piano,
    // Guitar, Ukulele, Fiddle, Clarinet, Oboe, Sax, Obosaxolele.
    const int numBodies = 11;
    // Shared log pole grid per line: 96 poles, 60 Hz .. 8 kHz, spacing <= 1/12 octave (T1).
    const int gridPoles = 96;
    // Per-body slot modes: up to 8 fixed-Hz feature modes and 10 Tune-following modes.
    const int featureStride = 8;
    const int followStride = 10;
    const int slotStride = 18;                       // featureStride + followStride
    const int slotModes = 198;                       // numBodies * slotStride

    // Delay-line sizes in stereo frames (concept section 3 and 16). 4096 covers C2 at 96 kHz
    // (1468 samples) and the 40 Hz Follow floor (2400); the piano string pair needs 8192.
    const int boreBufferSize = 4096;                 // clarinet cylinder
    const int saxBufferSize = 4096;                  // sax positive bore
    const int stringBufferSize = 4096;               // one shared string (Guitar, Ukulele, Fiddle)
    const int pianoBufferSize = 8192;                // two detuned piano strings
    const int pickBufferSize = 2048;                 // pick/position comb of the shared string

    // Control tick: coefficients and targets are stepped once per 32 samples (BODY:579).
    const int controlPeriod = 32;
    // Telemetry is emitted every max(1, int(sr / vizRateHz)) samples.
    const int vizRateHz = 30;
}

